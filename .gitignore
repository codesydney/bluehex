# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Claude Code's directory. The skills are checked in on purpose — every contributor
# gets them with no local setup — and nothing else in here is shared: local settings,
# session state, and worktrees, which are checkouts with their own .git file that
# `git add -A` would otherwise stage as embedded repositories, committing a broken
# pointer and none of the contents.
#
# `.claude/*` and not `.claude/`. A trailing-slash ignore on the directory stops git
# descending into it at all, and a negation cannot rescue anything git never looked at.
# Add further exceptions the same way if something else in here becomes shared.
.claude/*
!.claude/skills/

# typescript
*.tsbuildinfo
next-env.d.ts
